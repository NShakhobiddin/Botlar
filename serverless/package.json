{
  "name": "botlar-serverless",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless ommaviy xabar yuboruvchi — Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute botlar --remote --file schema.sql",
    "db:init:local": "wrangler d1 execute botlar --local --file schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
