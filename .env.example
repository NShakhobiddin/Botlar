# ---------------------------------------------------------------- majburiy

# Panel ochiladigan manzil. Webhook rejimida MAJBURIY va HTTPS bo'lishi shart —
# Telegram shu manzilga yangiliklarni o'zi yuboradi.
#
# Polling rejimida (tashqi serversiz, uy kompyuterida) bu qatorni bo'sh
# qoldirishingiz mumkin: bot Telegram'dan o'zi so'raydi, domen kerak emas.
# Mini App statistikasi esa baribir ochiq HTTPS manzil talab qiladi.
APP_URL=https://panel.example.uz

# PostgreSQL
DATABASE_URL=postgresql://botlar:PAROL@localhost:5432/botlar?schema=public

# Redis — broadcast navbati uchun
REDIS_URL=redis://localhost:6379

# Yuklangan rasm/video/fayllar shu papkada saqlanadi.
# Docker'da bu `media` volume'ga ulanadi — konteyner yangilansa ham saqlanib qoladi.
MEDIA_DIR=./data/media

# Bot tokenlarini shifrlash kaliti. Yaratish:  openssl rand -hex 32
# DIQQAT: bu kalitni yo'qotsangiz saqlangan tokenlarni ochib bo'lmaydi.
ENCRYPTION_KEY=

# Sessiya cookie imzosi. Yaratish:  openssl rand -hex 32
SESSION_SECRET=

# ------------------------------------------------- birinchi ishga tushirish
# `npm run seed` shu ma'lumotlar bilan panel egasini yaratadi.
ADMIN_EMAIL=siz@example.uz
ADMIN_PASSWORD=
ADMIN_NAME=Egasi

# ------------------------------------------------------------- ixtiyoriy
# Sekundiga nechta xabar yuborilsin (Telegram limiti ~30).
BROADCAST_RATE=25
# Bir vaqtda nechta broadcast ishlasin.
BROADCAST_CONCURRENCY=2
# Hodisalar tarixi necha kun saqlansin (0 — cheksiz).
EVENT_RETENTION_DAYS=180
# Polling rejimidagi botlarni bu jarayon tinglamasin (bir nechta worker bo'lsa).
# DISABLE_POLLER=true
# O'z Bot API serveringiz bo'lsa (katta fayllar uchun).
# TELEGRAM_API_URL=http://127.0.0.1:8081
